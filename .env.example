# Google AI Studio API key
GOOGLE_API_KEY=your_google_ai_studio_api_key

# Models
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# QueryDesk paths (relative to project root unless absolute paths are supplied)
QUERYDESK_UPLOAD_DIR=assets/uploaded_documents
QUERYDESK_VECTORSTORE_DIR=vectorstore

# Retrieval and chunking
QUERYDESK_CHUNK_SIZE=800
QUERYDESK_CHUNK_OVERLAP=120
QUERYDESK_TOP_K=4
QUERYDESK_MAX_TOOL_ROUNDS=6

# Used automatically if the primary model is temporarily unavailable
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
